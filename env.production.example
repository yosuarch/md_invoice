#--------------------------------------------------------------------
# de'makmur invoicing — production settings template
# Copy to .env on the server and fill in the values. Never commit .env.
# See DEPLOYMENT.md.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

# Public address of the app (HTTPS). Every redirect uses it.
app.baseURL = 'https://invoice.example.com/'
app.forceGlobalSecureRequests = true
app.indexPage = ''

# Generated with: php spark key:generate   (keep it; changing it logs everybody out)
encryption.key =

# Application database user: SELECT, INSERT, UPDATE, DELETE (+ CREATE, ALTER, INDEX, DROP, REFERENCES while
# running migrations). NOT TRIGGER / SUPER: protection triggers are installed by a DBA.
database.default.hostname = localhost
database.default.database = md_invoice
database.default.username =
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306

# Session cookie only over HTTPS
session.cookieName = 'md_session'
cookie.secure = true
cookie.httponly = true
cookie.samesite = 'Lax'

# Email (needed before enabling Shield magic-link login; see Config\Auth::$allowMagicLinkLogins)
# email.fromEmail = 'noreply@example.com'
# email.fromName  = 'Warung Sahabat'
# email.protocol  = 'smtp'
# email.SMTPHost  =
# email.SMTPUser  =
# email.SMTPPass  =
# email.SMTPPort  = 587
# email.SMTPCrypto = 'tls'
